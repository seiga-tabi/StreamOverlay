NODE_ENV=development
YORO_AGENT_ENABLED=false
YORO_AGENT_SERVER_ORIGIN=http://127.0.0.1:3000
YORO_AGENT_BOOTSTRAP_TOKEN_FILE=./secrets/bootstrap_token
YORO_AGENT_CREDENTIAL_FILE=./state/credential.json
YORO_AGENT_STATE_DIR=./state
YORO_AGENT_PUSH_INTERVAL_SECONDS=300
YORO_AGENT_REQUEST_TIMEOUT_MS=10000
YORO_AGENT_MAX_RETRY_ATTEMPTS=5
YORO_AGENT_HEALTH_HOST=127.0.0.1
YORO_AGENT_HEALTH_PORT=3200
PALWORLD_STATUS_ADAPTER=rest
PALWORLD_REST_ORIGIN=http://127.0.0.1:8212
PALWORLD_ADMIN_PASSWORD_FILE=./secrets/palworld_admin_password
PALWORLD_REQUEST_TIMEOUT_MS=5000
