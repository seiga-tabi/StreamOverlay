NODE_ENV=development
HOST_BIND=127.0.0.1
PRODUCTION_TRUST_PROXY=true
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5
HOST_PORT=3000
PORT=3000
APP_VERSION=0.1.0-dev
GIT_SHA=0000000000000000000000000000000000000000
BUILD_TIME=1970-01-01T00:00:00.000Z
YORO_SERVER_IMAGE=streamops-server:local
STREAMOPS_LOCAL_NO_AUTH=false
PUBLIC_BASE_URL=http://localhost:3000
DASHBOARD_BASE_URL=http://localhost:3000
OVERLAY_BASE_URL=http://localhost:3000/overlay
# Cloudflare Tunnel/공개 도메인 사용 시 위 3개 URL과 TWITCH_REDIRECT_URI, TWITCH_PUBLIC_REDIRECT_URI를 공개 도메인으로 맞춥니다.
# 예: https://stream.example.com, https://stream.example.com/overlay
# 모바일 전용 m 도메인을 함께 운영할 경우 같은 서버로 연결하고 CORS_ORIGINS에 모바일 origin도 추가합니다.
# 예: https://seiga.example.com, https://m.seiga.example.com
ALLOW_INSECURE_DEV=false
TRUST_PROXY=false
ALLOW_LEGACY_WS_QUERY_AUTH=false

TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/auth/callback
# 공개 전적 화면의 Twitch 로그인은 접속 중인 도메인의 callback URL을 사용합니다.
# m 도메인을 쓰면 Twitch Developer Console에 PC/모바일 callback을 모두 등록하세요.
# 예: https://seiga.example.com/api/public/twitch/auth/callback
# 예: https://m.seiga.example.com/api/public/twitch/auth/callback
TWITCH_PUBLIC_REDIRECT_URI=http://localhost:3000/api/public/twitch/auth/callback
# Twitch 채팅 명령어, 채널 포인트, 팔로우, 정기구독, 후원(Bits/Cheer)을 수신하려면 EventSub WebSocket이 켜져 있어야 합니다.
TWITCH_ENABLE_EVENTSUB=true
TWITCH_EVENTSUB_SUBSCRIPTIONS=stream.online stream.offline channel.chat.message channel.channel_points_custom_reward_redemption.add channel.follow channel.cheer channel.subscribe channel.subscription.message
TWITCH_EXTRA_SCOPES=moderator:read:followers bits:read channel:read:subscriptions
# 팔로워 목록 새로고침과 팔로우 취소 추정에는 moderator:read:followers가 필요합니다.
# Bits/Cheer 후원에는 bits:read, 정기구독에는 channel:read:subscriptions가 필요합니다.
# 설정을 바꾼 뒤에는 서버를 재시작하고 Twitch OAuth를 다시 승인해야 기존 token에 새 scope가 반영됩니다.
TWITCH_TOKEN_STORE_PATH=/app/.streamops/twitch-token.json
TWITCH_API_TIMEOUT_MS=10000

BRIDGE_SHARED_SECRET=replace_with_long_random_secret
BRIDGE_SHARED_SECRET_FILE=

# 신규 Discord SaaS 기반 전용 PostgreSQL입니다. 기존 JSON state에는 영향을 주지 않습니다.
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_URL_FILE=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_MIGRATION_MODE=check
DATABASE_SSL_MODE=disable

# Discord SaaS onboarding은 PostgreSQL migration 적용 후에만 활성화합니다.
DISCORD_SAAS_ENABLED=false
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Production에서는 직접 값 대신 DISCORD_CLIENT_SECRET_FILE을 사용하세요.
DISCORD_CLIENT_SECRET_FILE=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/discord/oauth/callback
DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY=
# Production에서는 직접 값 대신 DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY_FILE을 사용하세요.
DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY_FILE=
DISCORD_SETUP_LINK_TTL_SECONDS=600
DISCORD_OAUTH_SESSION_TTL_SECONDS=900
DISCORD_API_TIMEOUT_MS=10000
DISCORD_BOT_INTERNAL_API_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_BOT_INTERNAL_AUTH_KEY=
# Compose 컨테이너 내부 경로와 호스트의 secret 원본 경로를 구분합니다.
DISCORD_BOT_INTERNAL_AUTH_KEY_FILE=/run/secrets/discord_bot_internal_auth_key
DISCORD_BOT_INTERNAL_AUTH_KEY_SOURCE_FILE=./secrets/discord_bot_internal_auth_key
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
# Bot token 원본은 Server가 mount하는 ./secrets 밖에 둡니다.
DISCORD_BOT_TOKEN_SOURCE_FILE=./discord-bot-secrets/discord_bot_token
DISCORD_TEST_GUILD_ID=
DISCORD_BOT_INTERNAL_BASE_URL=http://server:3000
DISCORD_BOT_PUBLIC_BASE_URL=http://localhost:3000
DISCORD_BOT_HEALTH_PORT=3100
DISCORD_BOT_INTERNAL_TIMEOUT_MS=5000
DISCORD_BOT_MANAGEMENT_ENABLED=false
AGENT_INGESTION_ENABLED=false
AGENT_CREDENTIAL_TTL_DAYS=90
AGENT_CLOCK_SKEW_SECONDS=300
AGENT_NONCE_TTL_SECONDS=600
AGENT_MAXIMUM_BODY_BYTES=16384
AGENT_RATE_LIMIT_PER_MINUTE=120
DISCORD_MANAGEMENT_OAUTH_REDIRECT_URI=http://localhost:3000/api/discord/management/oauth/callback
DISCORD_MANAGEMENT_OAUTH_TTL_SECONDS=600
DISCORD_MANAGEMENT_IDLE_TTL_SECONDS=28800
DISCORD_MANAGEMENT_ABSOLUTE_TTL_SECONDS=86400
AGENT_BOOTSTRAP_TTL_SECONDS=600

# Riot API key는 dashboard 설정 화면에서도 등록할 수 있습니다.
# 웹에서 저장한 key는 STREAMOPS_STATE_DIR/riot-api-key.json에 저장되며 RIOT_API_KEY보다 우선 사용됩니다.
RIOT_API_KEY=your_riot_api_key
RIOT_ACCOUNT_REGION=asia
RIOT_LOL_PLATFORM=jp1
RIOT_API_TIMEOUT_MS=10000
CHAT_TRANSLATION_ENABLED=false
CHAT_TRANSLATION_PROVIDER=mock
CHAT_TRANSLATION_MAX_INPUT_LENGTH=180
CHAT_TRANSLATION_MAX_PER_MINUTE=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# 공개 도메인 사용 시 CORS_ORIGINS에 공개 origin을 추가합니다.
# 예: CORS_ORIGINS=https://stream.example.com,http://localhost:3000,http://localhost:5173,http://localhost:5174
# m 도메인을 함께 운영할 경우 모바일 origin도 반드시 추가합니다.
# 예: CORS_ORIGINS=https://seiga.example.com,https://m.seiga.example.com
CLOUDFLARE_TUNNEL_TOKEN=
# 서버 공개 배포 시 반드시 32자 이상의 긴 임의 문자열로 설정하세요.
# *_FILE을 사용하면 값을 파일에서 읽습니다. 직접 값과 *_FILE을 동시에 설정하지 마세요.
DASHBOARD_AUTH_TOKEN=
DASHBOARD_AUTH_TOKEN_FILE=
DASHBOARD_SESSION_TTL_MS=28800000
OVERLAY_ACCESS_TOKEN=
OVERLAY_ACCESS_TOKEN_FILE=

# Twitch OAuth token 파일 암호화 key. `openssl rand -base64 32`로 생성하며 다른 secret과 재사용하지 않습니다.
# production 배포 전 기존 token 파일을 백업해야 하며, key 변경 시 기존 파일을 읽을 수 없습니다.
TWITCH_TOKEN_ENCRYPTION_KEY=
TWITCH_TOKEN_ENCRYPTION_KEY_FILE=

# support@yoro.gg 수신 메일함. Cloudflare Email Worker와 같은 secret을 사용합니다.
SUPPORT_MAILBOX_ENABLED=false
SUPPORT_MAILBOX_ADDRESS=support@yoro.gg
SUPPORT_MAILBOX_WEBHOOK_SECRET=
SUPPORT_MAILBOX_WEBHOOK_SECRET_FILE=
# `openssl rand -base64 32`로 생성하며 변경하면 기존 암호화 메일함을 읽을 수 없습니다.
SUPPORT_MAILBOX_ENCRYPTION_KEY=
SUPPORT_MAILBOX_ENCRYPTION_KEY_FILE=
SUPPORT_MAILBOX_STATE_PATH=/app/.streamops/support-mailbox.json.enc
SUPPORT_MAILBOX_RETENTION_DAYS=90
SUPPORT_MAILBOX_MAX_MESSAGES=1000

# Palworld 서버 상태 기능은 환경 변수를 사용하지 않습니다.
# apps/server/config/palworld-server-status.json과 docs/PALWORLD_SERVER_STATUS.md를 확인하세요.

# 공개 개인정보 처리방침·이용약관 운영정보. production에서는 모두 확정값이 필요합니다.
# 개인 운영자의 법적 이름, 실제 연락 가능한 주소와 개인정보 보호 담당자를 입력합니다.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_ADDRESS=
LEGAL_PRIVACY_OFFICER_NAME=
LEGAL_CONTACT_EMAIL=support@yoro.gg
LEGAL_CONTACT_PHONE=
LEGAL_EFFECTIVE_DATE=
LEGAL_MINIMUM_AGE=14
# 각 언어로 적용할 법률과 우선 협의·관할을 구체적으로 작성합니다.
LEGAL_GOVERNING_LAW_KO=
LEGAL_GOVERNING_LAW_JA=
LEGAL_DISPUTE_VENUE_KO=
LEGAL_DISPUTE_VENUE_JA=
# 수탁자/서비스명, 업무, 처리 항목, 보유기간을 한 줄로 작성합니다.
LEGAL_PROCESSORS_KO=
LEGAL_PROCESSORS_JA=
# 이전받는 자, 국가, 항목, 목적, 시점·방법, 보유기간, 보호조치를 한 줄로 작성합니다.
LEGAL_CROSS_BORDER_TRANSFER_KO=
LEGAL_CROSS_BORDER_TRANSFER_JA=
