{
  "schemaVersion": 1,
  "environment": "production",
  "public": {
    "baseUrl": "https://yoro.gg",
    "dashboardOrigin": "https://yoro.gg"
  },
  "features": {
    "database": true,
    "discordSaas": true,
    "discordBot": true,
    "discordBotManagement": true,
    "discordParticipationAnnounce": false,
    "riotRso": false,
    "valorantPublic": false,
    "twitchEventSub": true,
    "twitchExtension": false
  },
  "database": {
    "poolMax": 10,
    "sslMode": "disable"
  },
  "discord": {
    "clientId": "123456789012345678",
    "applicationId": "123456789012345678",
    "oauthRedirectUri": "https://yoro.gg/api/discord/oauth/callback",
    "managementOauthRedirectUri": "https://yoro.gg/api/discord/management/oauth/callback",
    "prefixCommandsEnabled": false
  },
  "twitch": {
    "clientId": "public-twitch-client-id",
    "redirectUri": "https://yoro.gg/api/twitch/auth/callback",
    "publicRedirectUri": "https://yoro.gg/api/public/twitch/auth/callback",
    "extensionClientId": "publictwitchextensionclientid",
    "eventSubSubscriptions": [
      "stream.online",
      "stream.offline",
      "channel.chat.message",
      "channel.channel_points_custom_reward_redemption.add"
    ]
  },
  "riot": {
    "accountRegion": "asia",
    "lolPlatform": "kr",
    "rsoClientId": "public-riot-rso-client-id",
    "rsoRedirectUri": "https://yoro.gg/api/account/oauth/riot/callback",
    "rsoLogoutRedirectUri": "https://yoro.gg/api/account/oauth/riot/logout/callback",
    "valorantProductionApproved": false
  }
}
